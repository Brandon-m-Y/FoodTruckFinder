# Copy to .env and fill in. .env is gitignored.
#
# NOTE: the browser never reads this file. The public map uses the PUBLISHABLE
# key, which is hardcoded in frontend/js/config.js because a no-build static site
# has no way to inject env vars — and that is fine, it is designed to be public
# and RLS is what protects the data.
#
# Everything below is genuinely secret and server-side only.

# Cloudflare Turnstile. The SITEKEY is public (it goes in the page); the SECRET
# is not. These are Cloudflare's documented TEST values — always-pass, safe for
# local development. Replace with real keys before deploying.
TURNSTILE_SITEKEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Salt for sha256(salt || client_ip). Without a strong random value the stored
# ip_hashes are reversible by brute force over the IPv4 space.
#   openssl rand -hex 24
IP_HASH_SALT=change-me

# Supabase SECRET (service_role) key — bypasses RLS entirely. Used ONLY by the
# server-side sighting handler. Never ship this to a browser.
SUPABASE_SECRET_KEY=

# Project URL (not secret, duplicated here for server-side callers)
SUPABASE_URL=https://detmkrivpmfljqfazdzx.supabase.co

# Comma-separated raw IPs exempt from the per-IP daily caps. Empty by default —
# nothing is exempt unless listed. Do NOT add loopback on a proxied deployment:
# there the peer address is loopback for EVERY visitor, so it would exempt
# the whole internet. Leave this EMPTY in production; a home address left here
# is permanently exempt from every cap.
RATE_LIMIT_EXEMPT_IPS=

# Which proxy's client-IP header to trust. UNSET = direct connection, use the
# socket address (correct for local dev).
#
# Set this on any hosted deploy. Without it the socket peer is the platform's
# own proxy — identical for every visitor — so all traffic hashes to ONE
# ip_hash: the per-IP daily caps become a single global cap, and the
# one-review-per-person rule treats the entire internet as one person.
#
# Recognised: netlify | cloudflare | vercel | xff
# Only use `xff` if a reverse proxy YOU control SETS x-forwarded-for rather than
# appending to a client-supplied one — otherwise callers forge their own address
# and defeat every cap on purpose.
TRUST_PROXY=
